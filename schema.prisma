// Prisma Schema for Express Tow Backend
// Database: PostgreSQL
// Production-ready schema with all required tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DISPATCHER
  PARTNER_MANAGER
  FINANCE
  SUPPORT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  phone     String?
  role      UserRole @default(SUPPORT)
  status    UserStatus @default(PENDING)
  avatar    String?
  
  // Authentication
  lastLogin DateTime?
  loginCount Int @default(0)
  refreshToken String?
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  
  // Relations
  notifications Notification[]
  auditLogs AuditLog[]
  assignedBookings Booking[] @relation("AssignedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================
// CUSTOMER MANAGEMENT
// ============================================

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String   @unique
  
  // Additional Info
  address   String?
  city      String?
  state     String?
  zipCode   String?
  
  // Customer Type
  isVIP     Boolean @default(false)
  
  // Notes
  notes     String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastBookingAt DateTime?
  
  // Relations
  bookings  Booking[]

  @@index([email])
  @@index([phone])
  @@index([isVIP])
  @@map("customers")
}

// ============================================
// BOOKING MANAGEMENT
// ============================================

enum BookingStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ServiceType {
  EMERGENCY_TOW
  SCHEDULED_TOW
  FLATBED_TOW
  MOTORCYCLE_TOW
  HEAVY_DUTY_TOW
  JUMP_START
  TIRE_CHANGE
  LOCKOUT
  FUEL_DELIVERY
  WINCH_OUT
}

enum VehicleType {
  SEDAN
  SUV
  TRUCK
  MOTORCYCLE
  VAN
  EXOTIC
  HEAVY_DUTY
}

enum VehicleCondition {
  DRIVABLE
  NON_DRIVABLE_MINOR
  NON_DRIVABLE_MODERATE
  NON_DRIVABLE_MAJOR
}

model Booking {
  id        String   @id @default(uuid())
  bookingNumber String @unique // e.g., TOW-2024-001234
  
  // Customer reference
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  
  // Customer info (denormalized for quick access)
  customerName  String
  customerPhone String
  customerEmail String?
  
  // Location details
  pickupAddress  String
  pickupLat      Float?
  pickupLng      Float?
  pickupCity     String?
  pickupState    String?
  pickupZipCode  String?
  
  dropoffAddress String
  dropoffLat     Float?
  dropoffLng     Float?
  dropoffCity    String?
  dropoffState   String?
  dropoffZipCode String?
  
  // Service details
  serviceType   ServiceType
  vehicleType   VehicleType
  condition     VehicleCondition?
  vehicleYear   String?
  vehicleMake   String?
  vehicleModel  String?
  vehicleColor  String?
  vehiclePlate  String?
  
  // Pricing breakdown
  distance      Float // in miles
  estimatedTime Int   // in minutes
  baseFee       Float
  distanceFee   Float
  vehicleFee    Float
  timeFee       Float
  emergencyFee  Float
  recoveryFee   Float
  difficultyFee Float
  surcharges    Json? // Additional surcharges
  totalPrice    Float
  
  // Difficulty assessment
  difficultyLevel String?
  difficultyScore Int?
  
  // Assignment
  driverId      String?
  driver        Driver? @relation(fields: [driverId], references: [id])
  assignedAt    DateTime?
  assignedBy    String?
  assignedByUser User? @relation("AssignedBy", fields: [assignedBy], references: [id])
  
  // Status tracking
  status        BookingStatus @default(PENDING)
  statusHistory Json? // Array of status changes with timestamps
  
  // Scheduling
  scheduledFor  DateTime?
  startedAt     DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancellationReason String?
  
  // Additional details
  notes         String?
  internalNotes String?
  photos        Photo[]
  
  // Payment
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id])
  
  // SMS notifications
  smsLogs       SMSLog[]
  
  // Driver location tracking
  driverLocations DriverLocation[]
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([serviceType])
  @@index([bookingNumber])
  @@index([createdAt])
  @@index([scheduledFor])
  @@map("bookings")
}

// ============================================
// DRIVER MANAGEMENT
// ============================================

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_DUTY
  OFF_DUTY
  BUSY
  SUSPENDED
}

model Driver {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  
  // License Info
  licenseNumber String @unique
  licenseState  String
  licenseExpiry DateTime
  
  // Personal Info
  address   String?
  city      String?
  state     String?
  zipCode   String?
  dateOfBirth DateTime?
  
  // Employment
  hireDate  DateTime @default(now())
  status    DriverStatus @default(INACTIVE)
  
  // Current location
  currentLat Float?
  currentLng Float?
  lastLocationUpdate DateTime?
  
  // Availability
  isAvailable Boolean @default(false)
  
  // Performance
  rating    Float?
  totalJobs Int @default(0)
  
  // Documents
  documents Json? // Array of document URLs
  
  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  bookings  Booking[]
  vehicles  Vehicle[]
  locationHistory DriverLocation[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([isAvailable])
  @@map("drivers")
}

// ============================================
// DRIVER LOCATION TRACKING
// ============================================

model DriverLocation {
  id        String   @id @default(uuid())
  
  // Driver reference
  driverId  String
  driver    Driver @relation(fields: [driverId], references: [id])
  
  // Location coordinates
  latitude  Float
  longitude Float
  accuracy  Float?  // Accuracy in meters
  altitude  Float?  // Altitude in meters
  
  // Speed and heading
  speed     Float?  // Speed in m/s
  heading   Float?  // Direction in degrees (0-360)
  
  // Related booking (if on active job)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  
  // Status
  isActive  Boolean @default(true)
  
  // Metadata
  timestamp DateTime @default(now())
  source    String?  // 'gps', 'network', 'manual'
  metadata  Json?
  
  @@index([driverId])
  @@index([bookingId])
  @@index([timestamp])
  @@index([isActive])
  @@map("driver_locations")
}

// ============================================
// VEHICLE MANAGEMENT
// ============================================

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VehicleCategory {
  FLATBED
  WHEEL_LIFT
  INTEGRATED
  HEAVY_DUTY
  MOTORCYCLE_CARRIER
  SERVICE_TRUCK
}

model Vehicle {
  id        String   @id @default(uuid())
  
  // Vehicle Info
  year      String
  make      String
  model     String
  vin       String   @unique
  plate     String   @unique
  color     String?
  
  // Truck Details
  category  VehicleCategory
  capacity  Int? // Max towing capacity in lbs
  
  // Assignment
  driverId  String?
  driver    Driver? @relation(fields: [driverId], references: [id])
  
  // Status
  status    VehicleStatus @default(ACTIVE)
  
  // Maintenance
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  mileage   Int?
  
  // Insurance
  insuranceProvider String?
  insurancePolicy   String?
  insuranceExpiry   DateTime?
  
  // Registration
  registrationExpiry DateTime?
  
  // Inspection
  lastInspection DateTime?
  nextInspection DateTime?
  
  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([category])
  @@map("vehicles")
}

// ============================================
// PARTNER MANAGEMENT
// ============================================

enum PartnerStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

model Partner {
  id        String   @id @default(uuid())
  
  // Company Info
  companyName String
  contactName String
  email     String   @unique
  phone     String   @unique
  
  // Business Info
  businessType String?
  taxId     String?
  address   String
  city      String
  state     String
  zipCode   String
  
  // Agreement
  contractStartDate DateTime?
  contractEndDate   DateTime?
  commissionRate    Float? // Percentage
  
  // Status
  status    PartnerStatus @default(PENDING)
  
  // Application
  applicationNotes String?
  applicationDate  DateTime @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  
  // Documents
  documents Json? // Array of document URLs
  
  // Performance
  rating    Float?
  totalJobs Int @default(0)
  
  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("partners")
}

// ============================================
// SERVICE AREAS
// ============================================

model ServiceArea {
  id        String   @id @default(uuid())
  
  // Area Info
  name      String
  description String?
  
  // Geographic coverage
  city      String
  state     String
  zipCodes  String[] // Array of ZIP codes
  
  // Coordinates (for polygon/circle)
  centerLat Float?
  centerLng Float?
  radius    Float? // in miles
  polygon   Json? // GeoJSON polygon data
  
  // Service availability
  isActive  Boolean @default(true)
  
  // Pricing multiplier
  priceMultiplier Float @default(1.0)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([state])
  @@map("service_areas")
}

// ============================================
// PRICING RULES
// ============================================

enum RuleType {
  BASE_FEE
  PER_MILE
  TIME_SURCHARGE
  VEHICLE_SURCHARGE
  SERVICE_SURCHARGE
  DISTANCE_TIER
  SEASONAL
  PROMOTIONAL
}

model PricingRule {
  id        String   @id @default(uuid())
  
  // Rule Info
  name      String
  description String?
  type      RuleType
  
  // Rule configuration
  config    Json // Flexible JSON configuration for different rule types
  
  // Conditions
  conditions Json? // When this rule applies
  
  // Status
  isActive  Boolean @default(true)
  priority  Int @default(0) // Higher priority rules apply first
  
  // Date range
  validFrom DateTime?
  validUntil DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([type])
  @@index([isActive])
  @@map("pricing_rules")
}

// ============================================
// PAYMENT MANAGEMENT
// ============================================

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  CHECK
  BANK_TRANSFER
  PAYPAL
  STRIPE
  OTHER
}

model Payment {
  id        String   @id @default(uuid())
  
  // Booking reference
  bookings  Booking[]
  
  // Payment details
  amount    Float
  currency  String @default("USD")
  status    PaymentStatus @default(PENDING)
  method    PaymentMethod
  
  // Transaction details
  transactionId String? @unique
  stripePaymentIntentId String?
  
  // Billing info
  billingName    String?
  billingEmail   String?
  billingPhone   String?
  billingAddress String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  
  // Card info (last 4 digits only)
  cardLast4      String?
  cardBrand      String?
  
  // Refund
  refundedAmount Float?
  refundedAt     DateTime?
  refundReason   String?
  
  // Metadata
  metadata  Json?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt    DateTime?

  @@index([status])
  @@index([method])
  @@index([transactionId])
  @@index([createdAt])
  @@map("payments")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  BOOKING
  PAYMENT
  SYSTEM
  PARTNER
  DRIVER
  CUSTOMER
  ALERT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String   @id @default(uuid())
  
  // Recipient
  userId    String
  user      User @relation(fields: [userId], references: [id])
  
  // Content
  title     String
  message   String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  
  // Related entities
  relatedId String? // Booking ID, Payment ID, etc.
  relatedType String? // "booking", "payment", etc.
  
  // Status
  isRead    Boolean @default(false)
  readAt    DateTime?
  
  // Actions
  actionUrl String?
  actionLabel String?
  
  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// SMS NOTIFICATIONS
// ============================================

enum SMSStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

enum SMSType {
  BOOKING_CONFIRMED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  JOB_COMPLETED
  PAYMENT_RECEIVED
  BOOKING_CANCELLED
  OTHER
}

model SMSLog {
  id          String    @id @default(uuid())
  
  // Recipient
  to          String    // Phone number
  customerName String?
  
  // Content
  message     String
  type        SMSType
  
  // Related entities
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  
  // Twilio response
  twilioSid   String?   @unique
  status      SMSStatus @default(PENDING)
  errorCode   String?
  errorMessage String?
  
  // Tracking
  trackingUrl String?   // Customer tracking page URL
  
  // Timestamps
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Metadata
  metadata    Json?

  @@index([to])
  @@index([bookingId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("sms_logs")
}

// ============================================
// AUDIT LOGS
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  APPROVE
  REJECT
  ASSIGN
  CANCEL
}

enum AuditModule {
  AUTH
  BOOKINGS
  PAYMENTS
  USERS
  SETTINGS
  PARTNERS
  DRIVERS
  CUSTOMERS
  PRICING
  SERVICE_AREAS
  REPORTS
}

model AuditLog {
  id        String   @id @default(uuid())
  
  // User
  userId    String?
  user      User? @relation(fields: [userId], references: [id])
  userName  String?
  userEmail String?
  
  // Action details
  action    AuditAction
  module    AuditModule
  
  // Entity details
  entityType String? // "booking", "user", etc.
  entityId   String?
  
  // Details
  description String?
  changes     Json? // Before/after values
  
  // Request details
  ipAddress String?
  userAgent String?
  endpoint  String?
  method    String?
  
  // Status
  status    String? // "success", "failure"
  
  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// SETTINGS
// ============================================

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
}

model Setting {
  id        String   @id @default(uuid())
  
  // Setting identification
  key       String   @unique
  value     String   // Stored as string, parsed based on type
  type      SettingType
  
  // Metadata
  category  String?
  label     String?
  description String?
  
  // Validation
  validation Json? // Validation rules
  
  // Access control
  isPublic  Boolean @default(false) // Can be accessed without auth
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([key])
  @@index([category])
  @@map("settings")
}

// ============================================
// PHOTOS
// ============================================

model Photo {
  id          String   @id @default(uuid())
  
  // Booking reference
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // Image URLs
  url         String
  thumbnailUrl String?
  
  // Metadata
  filename    String
  size        Int
  format      String
  width       Int?
  height      Int?
  
  // Category
  category    String? // "vehicle_front", "vehicle_side", "damage", etc.
  
  // Timestamps
  uploadedAt  DateTime @default(now())

  @@index([bookingId])
  @@map("photos")
}
