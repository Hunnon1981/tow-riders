# ====================
# TOW RIDERS BACKEND - ENVIRONMENT VARIABLES
# Stripe Payment Integration
# ====================

# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - it's in .gitignore

# ====================
# SERVER CONFIGURATION
# ====================
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://towriders.com

# ====================
# STRIPE PAYMENT GATEWAY (REQUIRED FOR PAYMENTS)
# ====================
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use TEST keys for development, LIVE keys for production

# Stripe Secret Key (KEEP THIS SECRET - Server-side only)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Stripe Publishable Key (Public - Frontend can see this)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Stripe Webhook Secret (For webhook signature verification)
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ====================
# BUSINESS CONTACT INFORMATION
# ====================
BUSINESS_NAME=Tow Riders
BUSINESS_EMAIL=services@towriders.com
BUSINESS_PHONE=+19255469711
BUSINESS_PHONE_DISPLAY=+1 925-546-9711
BUSINESS_ADDRESS=Sacramento, CA
BUSINESS_WEBSITE=https://towriders.com

# ====================
# EMAIL SERVICE (SENDGRID)
# ====================
# SendGrid Email Service
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=services@towriders.com
EMAIL_FROM_NAME=Tow Riders
EMAIL_REPLY_TO=services@towriders.com

# ====================
# SMS SERVICE (Optional - for sending notifications)
# ====================
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+19255469711

# ====================
# DATABASE (Optional - if you add database later)
# ====================
DATABASE_URL=postgresql://user:password@host:port/database

# ====================
# GOOGLE SERVICES (Optional - for marketing)
# ====================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ADS_ID=AW-XXXXXXXXXX
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ====================
# FACEBOOK / META SERVICES (Optional)
# ====================
META_PIXEL_ID=XXXXXXXXXXXXXXX

# ====================
# SOCIAL MEDIA AUTOMATION (DISABLED BY DEFAULT)
# ====================
# ⚠️ Social automation is OFF by default for safety
# To enable: Set SOCIAL_AUTOMATION_ENABLED=true and configure all credentials below

# Master switch - Set to 'true' to enable social media posting
SOCIAL_AUTOMATION_ENABLED=false

# Meta Page Access Token (Long-lived, 60-day validity)
# Get from: https://developers.facebook.com/tools/explorer/
# Required permissions: pages_manage_posts, instagram_content_publish, pages_read_engagement
META_PAGE_ACCESS_TOKEN=

# Facebook Page ID
# Find at: https://www.facebook.com/[your-page] → About → Page ID
FACEBOOK_PAGE_ID=

# Instagram Business Account ID
# Get from: Graph API Explorer → [your-page] → ?fields=instagram_business_account
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Meta Webhook Verify Token (For webhook verification)
# Custom token you create - must match Meta App webhook configuration
# Recommended: Use a strong random string (e.g., tow_riders_webhook_2024_[random])
META_VERIFY_TOKEN=

# OpenAI API Key (Optional - for AI content generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ====================
# CORS CONFIGURATION
# ====================
# Allow requests from your frontend domain
CORS_ORIGIN=https://towriders.com,https://www.towriders.com
